;; Smart throttle, acceleration governor and traction control.
;;
;; Important: with only motor ERPM available, traction control cannot
;; distinguish wheel spin from a real acceleration with absolute certainty.
;; This preset therefore uses a filtered ERPM acceleration estimate and a
;; conservative speed envelope. A separate wheel-speed sensor is required
;; for true slip detection.

;; ====== 1. BASIC SETTINGS ======
(define base-current 40.5)
(define peak-current 62.0)
(define boost-current 75.0)
(define idle-current 1.0)
(define min-erpm 760.0)

;; 380 ERPM = 1 km/h.
(define erpm-3kmh 760.0)
(define erpm-max-current 2280.0)
(define erpm-boost-end 4180.0)
(define erpm-per-kmh 380.0)

;; ====== 2. THROTTLE AND SMOOTHNESS ======
(define v-start 0.85)
(define v-end 2.67)
(define expo-weight 0.33)

(define ramp-start 0.175)
(define ramp-fast 0.01)
(define ramp-erpm-max 4200.0)
(define ramp-neg 0.32)
(define loop-time 0.0005)

(define v-min 41.7)
(define v-cutoff 36.5)

(define fw-max-current 21.0)
(define fw-idle-current 5.0)
(define fw-throttle-start 0.7)

;; ====== 3. PERSISTENT TRACTION SETTINGS ======
;; EEPROM addresses 0..8 are reserved for this preset.
(define tc-eeprom-version 2)
(define tc-eeprom-version-address 0)
(define tc-eeprom-enabled-address 1)
(define tc-eeprom-accel-limit-enabled-address 2)
(define tc-eeprom-max-accel-address 3)
(define tc-eeprom-accel-band-address 4)
(define tc-eeprom-slip-threshold-address 5)
(define tc-eeprom-penalty-address 6)
(define tc-eeprom-recovery-address 7)
(define tc-eeprom-envelope-band-address 8)

;; Defaults. tc-load-config replaces these with EEPROM values when present.
(define traction-control-enabled 1)
(define acceleration-limit-enabled 1)
(define max-accel-ms2 1.5)
(define accel-soft-band-ms2 0.5)
(define slip-threshold-erpm 400.0)
(define penalty-factor 0.10)
(define recovery-rate 0.02)
(define envelope-soft-band-erpm 200.0)

;; ====== 4. RUNTIME STATE ======
(define current-out 0.0)
(define fast-current-cut 0)
(define adc-filtered 0.0)
(define adc-alpha 0.28)
(define step-down (* boost-current (/ loop-time ramp-neg)))

;; Motion estimator runs at 100 Hz instead of differentiating every 0.5 ms.
(define motion-sample-time 0.01)
(define motion-sample-elapsed 0.0)
(define motion-initialized 0)
(define motion-speed-alpha 0.35)
(define motion-accel-alpha 0.35)
(define speed-filtered-erpm 0.0)
(define speed-last-sampled-erpm 0.0)
(define measured-accel-ms2 0.0)

;; Speed envelope and traction cut state.
(define allowed-erpm 0.0)
(define traction-cut 1.0)

;; ====== 5. HELPERS AND EEPROM CONFIGURATION ======
(defun clamp (value low high)
    (if (< value low)
        low
        (if (> value high) high value)))

(defun tc-load-defaults ()
    (setvar 'traction-control-enabled 1)
    (setvar 'acceleration-limit-enabled 1)
    (setvar 'max-accel-ms2 1.5)
    (setvar 'accel-soft-band-ms2 0.5)
    (setvar 'slip-threshold-erpm 400.0)
    (setvar 'penalty-factor 0.10)
    (setvar 'recovery-rate 0.02)
    (setvar 'envelope-soft-band-erpm 200.0))

(defun tc-load-config ()
    (let ((version (eeprom-read-i tc-eeprom-version-address)))
        (if version
            (if (= version tc-eeprom-version)
                (progn
                    (setvar 'traction-control-enabled
                            (if (= (eeprom-read-i tc-eeprom-enabled-address) 0) 0 1))
                    (setvar 'acceleration-limit-enabled
                            (if (= (eeprom-read-i tc-eeprom-accel-limit-enabled-address) 0) 0 1))
                    (setvar 'max-accel-ms2
                            (clamp (eeprom-read-f tc-eeprom-max-accel-address) 0.1 10.0))
                    (setvar 'accel-soft-band-ms2
                            (clamp (eeprom-read-f tc-eeprom-accel-band-address) 0.1 3.0))
                    (setvar 'slip-threshold-erpm
                            (clamp (eeprom-read-f tc-eeprom-slip-threshold-address) 0.0 3000.0))
                    (setvar 'penalty-factor
                            (clamp (eeprom-read-f tc-eeprom-penalty-address) 0.01 1.0))
                    (setvar 'recovery-rate
                            (clamp (eeprom-read-f tc-eeprom-recovery-address) 0.001 1.0))
                    (setvar 'envelope-soft-band-erpm
                            (clamp (eeprom-read-f tc-eeprom-envelope-band-address) 1.0 3000.0)))
                (tc-load-defaults))
            (tc-load-defaults))))

(defun tc-save-config ()
    ;; EEPROM writes stop the motor briefly. This function is called only by
    ;; tc-set-config, never from the control loop.
    (eeprom-store-i tc-eeprom-enabled-address traction-control-enabled)
    (eeprom-store-i tc-eeprom-accel-limit-enabled-address acceleration-limit-enabled)
    (eeprom-store-f tc-eeprom-max-accel-address max-accel-ms2)
    (eeprom-store-f tc-eeprom-accel-band-address accel-soft-band-ms2)
    (eeprom-store-f tc-eeprom-slip-threshold-address slip-threshold-erpm)
    (eeprom-store-f tc-eeprom-penalty-address penalty-factor)
    (eeprom-store-f tc-eeprom-recovery-address recovery-rate)
    (eeprom-store-f tc-eeprom-envelope-band-address envelope-soft-band-erpm)
    ;; Commit marker is written last so a power loss keeps the old version invalid.
    (eeprom-store-i tc-eeprom-version-address tc-eeprom-version))

(defun tc-vehicle-stopped ()
    (if (< (abs (get-rpm)) 20.0)
        (if (< (abs (get-current)) 1.0) t nil)
        nil))

;; Called from VESC Tool Android through COMM_LISP_REPL_CMD.
(defun tc-set-config (enabled accel-limit-enabled max-accel accel-band slip-threshold-value penalty recovery envelope-band)
    (setvar 'traction-control-enabled (if (= enabled 0) 0 1))
    (setvar 'acceleration-limit-enabled (if (= accel-limit-enabled 0) 0 1))
    (setvar 'max-accel-ms2 (clamp max-accel 0.1 10.0))
    (setvar 'accel-soft-band-ms2 (clamp accel-band 0.1 3.0))
    (setvar 'slip-threshold-erpm (clamp slip-threshold-value 0.0 3000.0))
    (setvar 'penalty-factor (clamp penalty 0.01 1.0))
    (setvar 'recovery-rate (clamp recovery 0.001 1.0))
    (setvar 'envelope-soft-band-erpm (clamp envelope-band 1.0 3000.0))
    (if (tc-vehicle-stopped)
        (progn
            (tc-save-config)
            (print "TC_CONFIG_SAVED"))
        (print "TC_CONFIG_APPLIED_RAM_ONLY_STOP_VEHICLE_TO_SAVE")))

;; ====== 6. THROTTLE FUNCTIONS ======
(defun map-voltage (v)
    (let ((x (/ (- v v-start) (- v-end v-start))))
        (if (< x 0.0) 0.0
            (if (> x 1.0) 1.0 x))))

(defun calc-throttle (x)
    (let ((x3 (* x (* x x))))
        (+ (* expo-weight x3) (* (- 1.0 expo-weight) x))))

(defun get-dynamic-step-up (erpm)
    (let ((progress (if (> erpm ramp-erpm-max) 1.0 (/ erpm ramp-erpm-max))))
        (let ((current-ramp (- ramp-start (* progress (- ramp-start ramp-fast)))))
            (* boost-current (/ loop-time current-ramp)))))

(defun get-ramped (target current erpm)
    (if (> target current)
        (let ((dyn-step-up (get-dynamic-step-up erpm)))
            (let ((new-c (+ current dyn-step-up)))
                (if (> new-c target) target new-c)))
        (let ((rpm-factor (+ 1.0 (/ erpm 4000.0))))
            (let ((down-time (if (= fast-current-cut 1) 0.05 ramp-neg)))
                (let ((down-step (* boost-current (/ loop-time down-time))))
                    (let ((new-c (- current (* down-step rpm-factor))))
                        (if (< new-c target) target new-c)))))))

(defun get-dynamic-max (erpm)
    (if (< erpm erpm-3kmh)
        base-current
        (if (< erpm erpm-max-current)
            (let ((progress (/ (- erpm erpm-3kmh) (- erpm-max-current erpm-3kmh))))
                (let ((skewed-progress
                       (* (* progress progress)
                       (- 6.0 (* progress (- 8.0 (* 3.0 progress)))))))
                    (+ base-current (* skewed-progress (- peak-current base-current)))))
            (if (> erpm erpm-boost-end)
                boost-current
                (let ((progress2 (/ (- erpm erpm-max-current) (- erpm-boost-end erpm-max-current))))
                    (let ((cubic-progress (* progress2 (* progress2 progress2))))
                        (+ peak-current (* cubic-progress (- boost-current peak-current)))))))))

(defun get-voltage-multiplier ()
    (let ((vin (get-vin)))
        (if (< vin v-cutoff)
            0.0
            (if (> vin v-min)
                1.0
                (/ (- vin v-cutoff) (- v-min v-cutoff))))))

(defun calc-fw (linear-t)
    (if (< linear-t 0.05)
        fw-idle-current
        (if (> linear-t fw-throttle-start)
            (let ((fw-progress (/ (- linear-t fw-throttle-start) (- 1.0 fw-throttle-start))))
                (* fw-progress fw-max-current))
            0.0)))

;; ====== 7. MOTION AND TRACTION CONTROL ======
(defun get-max-erpm-step (sample-time)
    (* (* (* max-accel-ms2 3.6) erpm-per-kmh) sample-time))

(defun update-motion-estimator (erpm)
    (let ((elapsed (+ motion-sample-elapsed loop-time)))
        (if (>= elapsed motion-sample-time)
            (progn
                (setvar 'motion-sample-elapsed 0.0)
                (if (= motion-initialized 0)
                    (progn
                        (setvar 'motion-initialized 1)
                        (setvar 'speed-filtered-erpm erpm)
                        (setvar 'speed-last-sampled-erpm erpm)
                        (setvar 'allowed-erpm erpm)
                        (setvar 'measured-accel-ms2 0.0))
                    (let ((filtered-speed
                           (+ (* motion-speed-alpha erpm)
                              (* (- 1.0 motion-speed-alpha) speed-filtered-erpm))))
                        (let ((raw-accel
                               (/ (/ (- filtered-speed speed-last-sampled-erpm)
                                     erpm-per-kmh)
                                  (* 3.6 elapsed))))
                            (setvar 'speed-filtered-erpm filtered-speed)
                            (setvar 'speed-last-sampled-erpm filtered-speed)
                            (setvar 'measured-accel-ms2
                                    (+ (* motion-accel-alpha raw-accel)
                                       (* (- 1.0 motion-accel-alpha) measured-accel-ms2)))))))
            (setvar 'motion-sample-elapsed elapsed))))

(defun get-accel-multiplier ()
    (if (= acceleration-limit-enabled 0)
        1.0
        (if (<= measured-accel-ms2 max-accel-ms2)
        1.0
        (if (>= measured-accel-ms2 (+ max-accel-ms2 accel-soft-band-ms2))
            0.0
            (- 1.0
               (/ (- measured-accel-ms2 max-accel-ms2) accel-soft-band-ms2))))))

(defun get-traction-multiplier (erpm linear-throttle)
    (if (= traction-control-enabled 0)
        (progn
            (setvar 'allowed-erpm speed-filtered-erpm)
            (setvar 'traction-cut 1.0)
            1.0)
        (if (< linear-throttle 0.05)
            (progn
                (setvar 'allowed-erpm speed-filtered-erpm)
                (setvar 'traction-cut 1.0)
                1.0)
            (let ((max-step (get-max-erpm-step loop-time)))
                (progn
                    (let ((next-allowed (+ allowed-erpm max-step)))
                        (if (> speed-filtered-erpm next-allowed)
                            (setvar 'allowed-erpm next-allowed)
                            (setvar 'allowed-erpm speed-filtered-erpm)))

                    (let ((envelope-excess (- speed-filtered-erpm allowed-erpm)))
                        (progn
                            (if (> envelope-excess slip-threshold-erpm)
                                (setvar 'traction-cut penalty-factor)
                                (setvar 'traction-cut
                                        (+ traction-cut
                                           (* (- 1.0 traction-cut)
                                              (* recovery-rate (/ loop-time motion-sample-time))))))

                            (let ((envelope-multiplier
                                   (if (<= envelope-excess 0.0)
                                       1.0
                                       (if (>= envelope-excess envelope-soft-band-erpm)
                                           0.0
                                           (- 1.0
                                              (/ envelope-excess envelope-soft-band-erpm))))))
                                (if (< traction-cut envelope-multiplier)
                                    traction-cut
                                    envelope-multiplier)))))))))

;; Load persistent settings before starting the control loop.
(tc-load-config)

;; ====== 8. MAIN CONTROL LOOP ======
(loopwhile t
    (progn
        (let ((raw-v (get-adc 0))
              (raw-rpm (get-rpm)))
            (progn
                (setvar 'adc-filtered
                        (+ (* adc-alpha raw-v) (* (- 1.0 adc-alpha) adc-filtered)))

                (let ((erpm (if (< raw-rpm 0) (* raw-rpm -1.0) raw-rpm))
                      (linear-throttle (map-voltage adc-filtered)))
                    (progn
                        (update-motion-estimator erpm)
                        (conf-set 'foc-fw-current-max (calc-fw linear-throttle))

                        (let ((throttle (calc-throttle linear-throttle))
                              (accel-multiplier (get-accel-multiplier))
                              (traction-multiplier (get-traction-multiplier erpm linear-throttle)))
                            (let ((current-max-allowed
                                   (* (get-dynamic-max erpm) (get-voltage-multiplier))))
                            (let ((control-multiplier
                                   (if (< accel-multiplier traction-multiplier)
                                       accel-multiplier
                                       traction-multiplier)))
                                (setvar 'fast-current-cut
                                        (if (< control-multiplier 0.95) 1 0))
                                (let ((target-current
                                           (if (< linear-throttle 0.05)
                                               (if (> erpm min-erpm) idle-current 0.0)
                                               (* (* throttle current-max-allowed)
                                                  control-multiplier))))
                                        (let ((new-current
                                               (get-ramped target-current current-out erpm)))
                                            (setvar 'current-out new-current)
                                            (set-current new-current))))))))))
        (sleep loop-time)))
