;; Run by run_gearbox_sound.py after loading the actual preset definitions.
(defun check (condition message)
    (if (not condition)
        (progn
            (print (list 'sound-state gs-playing current-out throttle-armed tc-saving
                         test-time control-last-time gs-config test-tones))
            (print message)
            (exit-error message))))
(defun near (left right) (< (abs (- left right)) (+ 0.0001 (* (abs right) 0.000001))))
(defun total-volume () (apply + (map (lambda (tone) (ix tone 2)) test-tones)))
(defun tick ()
    (progn
        (setvar 'test-time (+ test-time 0.02))
        (setvar 'control-last-time test-time)
        (setvar 'test-tones nil)
        (gs-step)))
(defun settle () (looprange sample 0 100 (tick)))

(check (gs-valid-config gs-default-config) "defaults must be valid")
(check (not (gs-valid-config '(1.0 60.0 10.0 4.0 358.0 0.02 1.15 220.0 1500.0 0.12)))
       "reversed speeds must be rejected")
(check (not (gs-valid-config '(1.0 10.0 60.0 4.0 358.0 0.02 0.01 220.0 1500.0 0.12)))
       "maximum below preload must be rejected")
(check (near (gs-speed-position 0.0 gs-config) 0.0) "base pitch below start speed")
(check (near (gs-speed-position 10.0 gs-config) 0.0) "base pitch at start speed")
(check (near (gs-speed-position 60.0 gs-config) 1.0) "full pitch at end speed")
(check (near (gs-speed-position 200.0 gs-config) 1.0) "pitch is clamped at overspeed")
(check (> (gs-speed-position 35.0 gs-config) 0.5) "pitch curve must be logarithmic")

;; Erased EEPROM must leave defaults intact, including nil reads.
(gs-load-config)
(check (eq gs-config gs-default-config) "erased EEPROM defaults")
(setvar 'throttle-armed 1)
(setvar 'current-out idle-current)
(setvar 'test-rpm 800.0)
(settle)
(check (= (length test-tones) 4) "all four channels play during preload below 10 km/h")
(check (near (total-volume) 0.02) "preload must remain very quiet")
(check (near gs-pitch 220.0) "low speed preload uses base pitch")
(define sound-worker (spawn-trap 256 (lambda () (looprange frame 0 10 (tick)))))
(define worker-result (recv ((? message) message)))
(check (eq (ix worker-result 0) 'exit-ok) "audio must fit the 256-word context stack")

(setvar 'gs-requested-current 50.0)
(setvar 'current-out 50.0)
(setvar 'vt-throttle 100.0)
(setvar 'test-rpm (* 60.0 erpm-per-kmh))
(settle)
(check (near (total-volume) 1.15) "full throttle maximum is total channel amplitude")
(check (near gs-pitch 1720.0) "full speed reaches configured pitch")
(check (near (gs-drive-level) 1.0) "full delivered torque sounds loaded")

(setvar 'vt-tc-cut 0.1)
(setvar 'current-out 5.0)
(settle)
(check (< (total-volume) 0.15) "traction control must reduce sound with throttle still held")
(check (> (total-volume) 0.02) "traction limiting preserves preload tone")
(setvar 'vt-tc-cut 1.0)
(setvar 'current-out 5.0)
(check (< (gs-drive-level) 0.1) "independent acceleration limiting also lowers sound")
(setvar 'current-out idle-current)
(settle)
(check (near (total-volume) 0.02) "limiting to preload leaves only quiet sound")
(setvar 'vt-throttle 0.0)
(settle)
(check (= (length test-tones) 4) "released throttle does not mute active coasting preload")
(check (near (total-volume) 0.02) "released throttle uses quiet preload")

;; Every inhibit stops existing tones once, without spamming foc-play-stop.
(setvar 'current-out 0.0)
(tick)
(check (= gs-playing 0) "no current stops sound")
(define stops-before test-stops)
(tick)
(check (= stops-before test-stops) "inactive sound does not repeatedly stop audio")
(setvar 'current-out idle-current)
(setvar 'throttle-armed 0)
(tick)
(check (= gs-playing 0) "startup interlock mutes sound")
(setvar 'throttle-armed 1)
(setvar 'tc-saving 1)
(tick)
(check (= gs-playing 0) "EEPROM interlock mutes sound")
(setvar 'tc-saving 0)
(setvar 'test-vin v-cutoff)
(tick)
(check (= gs-playing 0) "battery cutoff mutes sound")
(setvar 'test-vin 50.0)
(tick)
(check (= gs-playing 1) "sound resumes with drive")
(setvar 'test-time (+ test-time 0.2))
(gs-step)
(check (= gs-playing 0) "stale current loop must not keep sound playing")

;; Sound persistence must not touch traction EEPROM addresses.
(setvar 'current-out 0.0)
(setvar 'test-rpm 0.0)
(gs-set-config 0 12.0 70.0 3.0 380.0 0.01 1.0 200.0 1200.0 0.15)
(check (= (eeprom-read-i 16) 1) "successful save writes version last")
(check (= (ix test-eeprom 0) 99) "sound save preserves traction EEPROM")
(setvar 'gs-config gs-default-config)
(gs-load-config)
(check (near (ix gs-config 1) 12.0) "sound settings survive restart")
(check (= (ix gs-config 0) 0.0) "disabled state survives restart")
(setvar 'current-out 10.0)
(tick)
(check (= gs-playing 0) "disabled setting mutes sound")

(setvar 'test-rpm 800.0)
(gs-set-config 1 10.0 60.0 4.0 358.0 0.02 1.15 220.0 1500.0 0.12)
(check (near (ix gs-config 1) 10.0) "moving change applies in RAM")
(check (near (eeprom-read-f 18) 12.0) "moving change does not write EEPROM")
(define config-before gs-config)
(gs-set-config 1 60.0 10.0 4.0 358.0 0.02 1.15 220.0 1500.0 0.12)
(check (eq gs-config config-before) "invalid settings cannot replace active configuration")

(setvar 'test-rpm 0.0)
(setvar 'test-write-fails 1)
(gs-set-config 1 10.0 60.0 4.0 358.0 0.02 1.15 220.0 1500.0 0.12)
(check (= (eeprom-read-i 16) 0) "failed write leaves invalid version marker")
(setvar 'gs-config gs-default-config)
(gs-load-config)
(check (eq gs-config gs-default-config) "partial EEPROM save falls back to defaults")

;; Exercise the unmodified control-step with function bodies stored in flash.
(setvar 'test-rpm 800.0)
(setvar 'current-out 0.0)
(setvar 'throttle-armed 0)
(looprange frame 0 20
    (progn
        (setvar 'test-time (+ test-time 0.02))
        (control-step)))
(check (= throttle-armed 1) "control loop still arms after throttle release")
(check (> test-current-command 0.0) "coasting preload still commands current")
(check (near gs-requested-current 0.0) "preload is separate from throttle demand")
(tick)
(check (= (length test-tones) 4) "actual control loop preload enables audio")
(setvar 'test-adc 2.67)
(looprange frame 0 20
    (progn
        (setvar 'test-time (+ test-time 0.02))
        (control-step)))
(check (> gs-requested-current idle-current) "control loop publishes drive demand to audio")
(check (> vt-throttle 50.0) "audio retains linear throttle telemetry")
(print "GEARBOX_SOUND_TESTS_PASSED")
t
